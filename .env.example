# ============================================================
# Finance Shorts Pro - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- AI Script Generation Models ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SCRIPT_MODEL=gemini-flash-lite-latest
VIDEO_MODEL=heygen/heygen-video-1
SCHEDULE_EXCEL=data\publishing_schedule.xlsx

# --- Voice / TTS & Audio Mix ---
DEFAULT_VOICE=en-US-AndrewMultilingualNeural
PIPER_EXECUTABLE=piper\piper.exe
PIPER_VOICE_MODEL=assets\voices\en_US-lessac-medium.onnx
PIPER_SPEAKING_RATE=1.0
BGM_VOLUME=0.18
VOICE_VOLUME=1.25

# --- Ollama / Local LLM (Optional Fallback) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048
OLLAMA_TIMEOUT=120
OLLAMA_RETRY_COUNT=3

# --- Paths ---
PROJECT_ROOT=.
EXCEL_FILE=data\finance_content_queue.xlsx
SQLITE_DB=data\finance_shorts.db
OUTPUT_DIR=output
LOGS_DIR=logs
ASSETS_DIR=assets

# --- Video Settings ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_BITRATE=4000k
AUDIO_BITRATE=192k
TARGET_DURATION_MIN=30
TARGET_DURATION_MAX=60

# --- Visual Plates (Antigravity-Generated Stills) ---
ANTIGRAVITY_GEN_SCRIPT=
IMAGE_MAX_LUMA=90
PLATE_DIR=assets/plates
PLATE_FALLBACK=assets/presenter/mentor_character_1.png
KENBURNS_MAX_ZOOM=1.06
KENBURNS_FPS=30

# --- Publishing Schedule (Asia/Kolkata) ---
TIMEZONE=Asia/Kolkata
PUBLISH_TIMES=09:00,15:00,20:00
MAX_VIDEOS_PER_DAY=3
MIN_QUEUE_BUFFER=3

# --- Publishing Mode ---
# Options: test | production
PUBLISHING_MODE=production

# --- YouTube API ---
YOUTUBE_CLIENT_SECRETS_FILE=config\youtube_client_secrets.json
YOUTUBE_TOKEN_FILE=config\youtube_token.json
YOUTUBE_CATEGORY_ID=27
# 27 = Education

# --- Instagram Graph API (Optional) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Channel Branding ---
CHANNEL_NAME=FinanceSimple
CHANNEL_TAGLINE="Money made simple"

# --- Content Defaults ---
DEFAULT_AUDIENCE=beginners
SCRIPT_MIN_WORDS=75
SCRIPT_MAX_WORDS=130

# --- Notifications (Optional) ---
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_PASSWORD=
